{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "@tvseri.es/api#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/infra/**",
        "$TURBO_ROOT$/apps/auth/src/**",
        "$TURBO_ROOT$/packages/kill-switch/**"
      ],
      "outputs": []
    },
    "//#check-types:infra": {
      "inputs": [
        "sst.config.ts",
        "sst-env.d.ts",
        "infra/**",
        "tsconfig.infra.json"
      ]
    },
    "//#format-and-lint": {},
    "//#format-and-lint:fix": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "outputs": []
    }
  },
  "ui": "tui"
}
