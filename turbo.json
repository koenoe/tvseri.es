{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "@tvseri.es/api#test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/infra/**",
        "$TURBO_ROOT$/apps/auth/src/**",
        "$TURBO_ROOT$/packages/kill-switch/**"
      ],
      "outputs": []
    },
    "@tvseri.es/web#test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/extension/**"],
      "outputs": []
    },
    "//#check-types:infra": {
      "inputs": [
        "sst.config.ts",
        "sst-env.d.ts",
        "infra/**",
        "packages/constants/src/**",
        "tsconfig.infra.json"
      ]
    },
    "//#format-and-lint": {},
    "//#format-and-lint:fix": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "transit": {
      "dependsOn": ["^transit"]
    }
  },
  "ui": "tui"
}
