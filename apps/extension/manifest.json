{
  "action": {
    "default_icon": {
      "16": "icons/idle-16.png",
      "32": "icons/idle-32.png"
    },
    "default_popup": "popup.html",
    "default_title": "tvseri.es"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "description": "Connect streaming services to your tvseri.es account.",
  "externally_connectable": {
    "matches": ["https://www.tvseri.es/*"]
  },
  "host_permissions": [
    "https://netflix.com/*",
    "https://*.netflix.com/*",
    "https://bbc.co.uk/*",
    "https://*.bbc.co.uk/*",
    "https://primevideo.com/*",
    "https://*.primevideo.com/*",
    "https://www.tvseri.es/*"
  ],
  "icons": {
    "16": "icons/active-16.png",
    "32": "icons/active-32.png",
    "48": "icons/active-48.png",
    "128": "icons/active-128.png"
  },
  "key": "",
  "manifest_version": 3,
  "name": "tvseri.es",
  "permissions": ["cookies", "storage"],
  "version": "0.2.0"
}
