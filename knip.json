{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "exclude": ["duplicates"],
  "ignore": [".claude/**"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "ignoreWorkspaces": ["packages/typescript-config"],
  "workspaces": {
    "apps/api": {
      "entry": ["src/index.ts", "src/lambdas/*.ts"]
    },
    "apps/auth": {
      "entry": ["src/index.ts", "e2e/harness/*.ts"]
    },
    "apps/dashboard": {
      "entry": ["src/routes/**/*.tsx"]
    },
    "apps/web": {
      "entry": [
        "test/empty.ts",
        "scripts/*.mjs",
        "e2e/stub-api/fixtures/**/*.ts",
        "e2e/helpers/*.ts"
      ],
      "project": [
        "**/*.{js,mjs,cjs,ts,tsx,css}",
        "!src/app/(site)/dev/style-guide/_sections/IconSection.tsx"
      ]
    },
    "packages/kill-switch": {
      "entry": [
        "disable-cloudfront-distributions/index.mjs!",
        "metrics-monitor/index.ts!"
      ]
    },
    "tools/load": {
      "entry": ["src/*.load.ts"],
      "ignoreDependencies": ["@openauthjs/openauth"]
    }
  }
}
